{
  "name": "@tser239/openslimedit",
  "version": "1.0.5",
  "description": "OpenCode v2 plugin that reduces token usage by up to 45% — compresses tool descriptions, compacts read output, adds line-range edit support",
  "type": "module",
  "license": "MIT",
  "author": "tser239",
  "repository": {
    "type": "git",
    "url": "https://github.com/tser239/openslimedit-v2.git"
  },
  "homepage": "https://github.com/tser239/openslimedit-v2",
  "bugs": {
    "url": "https://github.com/tser239/openslimedit-v2/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "token-optimization",
    "llm",
    "code-editing",
    "ai"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "bun run build"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
